{
  "name": "concord-desktop",
  "version": "0.4.0",
  "description": "CONCORD Desktop para Windows",
  "main": "desktop/main.cjs",
  "private": true,
  "author": "CONCORD",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/TnSilva777/concord-app.git"
  },
  "scripts": {
    "start": "electron .",
    "desktop:build": "npm run desktop:icon && electron-builder --win nsis --publish never",
    "desktop:release": "npm run desktop:icon && electron-builder --win nsis --publish always",
    "desktop:icon": "node desktop/generate-icon.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "sharp": "^0.34.3",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "app.concord.desktop",
    "productName": "CONCORD",
    "protocols": [{"name":"CONCORD Login","schemes":["concord"]}],
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/assets/concord.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "CONCORD-Setup-${version}.${ext}",
      "installerIcon": "desktop/assets/concord.ico",
      "uninstallerIcon": "desktop/assets/concord.ico",
      "installerHeaderIcon": "desktop/assets/concord.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "TnSilva777",
        "repo": "concord-app",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "index.html",
        "to": "web/index.html"
      },
      {
        "from": "manifest.json",
        "to": "web/manifest.json"
      }
    ]
  }
}
